/dts-v1/;

/ {
	model = "Sparky1";
	compatible = "spk,sparky1";
	#address-cells = <1>;
	#size-cells = <1>;

	chosen {
		stdout-path = "serial0:115200n8";
		tick-timer = "timer0";
	};

	aliases {
		serial0 = &uart0;
	};

    uart0: uart@80000000 {
        compatible = "exar,xr68c681";
        reg = <0x80000000 0x10>;
		status = "okay";
		bootph-all;
    };

    timer0: timer@80000000 {
        compatible = "exar,xr68c681_timer";
        reg = <0x80000000 0x10>;
		clock-frequency = <100>;
		status = "okay";
		bootph-all;
    };

    gpio0: gpio0@80000000 {
        compatible = "motorola,mc68681_gpio";
        reg = <0x80000000 0x10>;
    	gpio-controller;
		#gpio-cells = <2>;
		gpio-bank-name="o";
		ngpios = <8>;
		status = "okay";
	};

    /*
     * CompactFlash in True IDE mode: 8 byte-wide registers selected by
     * A2-A0, on an 8-bit port at D31-D24. /DISKCS and the ATA strobes come
     * from plds/cfmanager in the sparky1 hardware project.
     *
     * The generic IDE driver takes its addressing from CONFIG_SYS_ATA_*,
     * so this node exists to bind the driver and to record the hardware;
     * reg is not read back by the driver.
     */
    ide0: ide@c0000000 {
        compatible = "u-boot,ide";
        reg = <0xc0000000 0x8>;
        status = "okay";
    };

    gpio1: gpio1@80000000 {
        compatible = "motorola,mc68681_gpio";
        reg = <0x80000000 0x10>;
    	gpio-controller;
		#gpio-cells = <2>;
		gpio-bank-name="i";
		ngpios = <6>;
		status = "okay";
	};
};
